{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "TF_USE_LEGACY_KERAS": "1"
  },
  "build": {
    "env": {
      "TF_USE_LEGACY_KERAS": "1"
    }
  },
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "app/main.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
